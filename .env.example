# Postgres connection string. On Vercel, adding Supabase from the Marketplace
# sets POSTGRES_URL for you; either name works. Leave unset to run device-only.
DATABASE_URL=

# Sends parents and teachers their sign-in codes (https://resend.com).
# Without it, development prints codes to the server log; production refuses.
RESEND_API_KEY=
EMAIL_FROM="Prayog <no-reply@your-domain>"

# Pilot gate: teacher emails or school domains allowed to sign up,
# comma-separated, e.g. "head@school.in,@dps.edu.in".
TEACHER_ALLOWLIST=

# Suggestion box: files each idea as a GitHub issue for the weekly review.
# Use a fine-grained token with only "Issues: read and write" on that one repo.
# Ideas are also kept in the database when DATABASE_URL is set. With neither,
# ideas wait on the student's device until one is switched on.
SUGGESTIONS_GITHUB_TOKEN=
SUGGESTIONS_GITHUB_REPO=owner/repo

# Grievance officer shown on /privacy (DPDP Section 8(10)).
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_EMAIL=

# Daily retention job (vercel.json crons). Vercel sends it as a Bearer token.
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
