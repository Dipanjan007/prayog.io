# Postgres connection string. On Vercel, adding Supabase from the Marketplace
# sets POSTGRES_URL for you; either name works. Leave unset to run device-only.
DATABASE_URL=

# Sends parents and teachers their sign-in codes (https://resend.com).
# Without it, development prints codes to the server log; production refuses.
RESEND_API_KEY=
EMAIL_FROM="Prayog <no-reply@your-domain>"

# Pilot gate: teacher emails or school domains allowed to sign up,
# comma-separated, e.g. "head@school.in,@dps.edu.in".
TEACHER_ALLOWLIST=
